APP_NAME=HistoryGuessr
APP_ENV=local
APP_KEY=
APP_DEBUG=true
APP_URL=http://localhost:8080
APP_PORT=8080

APP_LOCALE=ru
APP_FALLBACK_LOCALE=en
APP_FAKER_LOCALE=ru_RU

APP_MAINTENANCE_DRIVER=file

BCRYPT_ROUNDS=12

LOG_CHANNEL=stack
LOG_STACK=single
LOG_DEPRECATIONS_CHANNEL=null
LOG_LEVEL=debug

DB_CONNECTION=pgsql
DB_HOST=postgres
DB_PORT=5432
DB_DATABASE=historyguessr
DB_USERNAME=historyguessr
DB_PASSWORD=secret

# Anonymous players are bound to the session cookie, so it lives long (30 days).
SESSION_DRIVER=redis
SESSION_LIFETIME=43200
SESSION_ENCRYPT=false
SESSION_PATH=/
SESSION_DOMAIN=null
SANCTUM_STATEFUL_DOMAINS=localhost:8080,127.0.0.1:8080

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=s3
QUEUE_CONNECTION=redis

CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null
MAIL_HOST=mailpit
MAIL_PORT=1025
MAIL_USERNAME=null
MAIL_PASSWORD=null
MAIL_FROM_ADDRESS="hello@example.com"
MAIL_FROM_NAME="${APP_NAME}"

# Local S3 = RustFS (docker service "s3"). AWS_ENDPOINT is used by PHP inside Docker, AWS_URL by the browser.
AWS_ACCESS_KEY_ID=s3-local
AWS_SECRET_ACCESS_KEY=s3-local-secret
AWS_DEFAULT_REGION=us-east-1
AWS_BUCKET=historyguessr
AWS_ENDPOINT=http://s3:9000
AWS_URL=http://localhost:9000/historyguessr
AWS_PUBLIC_ENDPOINT=http://localhost:9000
AWS_USE_PATH_STYLE_ENDPOINT=true

# Livewire temporary uploads (admin forms). `s3` needs a browser-reachable endpoint and bucket CORS.
LIVEWIRE_TEMPORARY_FILE_UPLOAD_DISK=local

VITE_APP_NAME="${APP_NAME}"
