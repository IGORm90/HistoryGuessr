# Pinned inputs of the self-hosted map. Bump deliberately; see docker/maps/README.md.
# The VersaTiles image itself is pinned in docker-compose.yml (service `maps`).

# Dated OSM snapshot from https://download.versatiles.org (never `latest`).
OSM_SNAPSHOT=osm.20260608
OSM_SOURCE_URL=https://download.versatiles.org/${OSM_SNAPSHOT}.versatiles

# Label fonts used by the generated style (noto_sans_regular, noto_sans_bold).
FONTS_URL=https://github.com/versatiles-org/versatiles-fonts/releases/download/v3.0.0/noto_sans.tar.gz
FONTS_SHA256=f58be6be2eb3d127b6ff1c90d828b69ff4807d1d88cd13a43930943fda0e334e

# Map icons; must match the @versatiles/style version in package.json.
SPRITES_URL=https://github.com/versatiles-org/versatiles-style/releases/download/v6.4.0/sprites.tar.gz
SPRITES_SHA256=5f6373986369684a0f209ece8e852331b6e2e99712ead6a7e094c349ed995c7f
